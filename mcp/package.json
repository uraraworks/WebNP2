{
  "name": "webnp2-mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "MCP server that operates the WebNP2 (PC-98 emulator) running in a browser via a WebSocket bridge",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "bundle": "esbuild server.mjs --bundle --platform=node --format=esm --target=node18 --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __webnp2CreateRequire}from'node:module';const require=__webnp2CreateRequire(import.meta.url);\" --outfile=dist/webnp2-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
